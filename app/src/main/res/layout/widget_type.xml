<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_fallback" android:importantForAccessibility="no" />
    <ViewFlipper android:id="@+id/w_fx" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="220" android:importantForAccessibility="no">
        <ImageView android:id="@+id/w_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <ImageView android:id="@+id/w_f7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    </ViewFlipper>
    <FrameLayout android:id="@+id/w_rc" android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFFFFFFF" android:textSize="52sp" android:fontFamily="sans-serif-thin" android:includeFontPadding="false" />
        <TextView android:layout_width="1dp" android:layout_height="44dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="#2EFFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_cond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
            <TextClock android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm · EEE d MMM" android:format24Hour="HH:mm · EEE d MMM" android:textColor="#99FFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-light" />
            <TextView android:id="@+id/w_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="12sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
